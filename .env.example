# CommerceTwin Environment Configuration
# Copy this file to .env and fill in real values before running.
# Never commit .env to version control.

# ── Application ─────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
HOST=0.0.0.0
PORT=8000

# ── Database ─────────────────────────────────────────────────────────────────
# Default: SQLite (development). For production, use PostgreSQL.
DATABASE_URL=sqlite:///./commercetwin.db
# DATABASE_URL=postgresql://user:password@localhost:5432/commercetwin

# ── Razorpay (Test Mode ONLY) ─────────────────────────────────────────────────
# IMPORTANT: ONLY test mode keys are permitted. The system actively rejects live keys.
# Sign up at https://dashboard.razorpay.com/ and use the "Test Mode" toggle.
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE

# ── Razorpay Webhook Secret ───────────────────────────────────────────────────
# Set this to the webhook secret configured in the Razorpay dashboard.
# Leave blank in development (signature verification will be skipped).
RAZORPAY_WEBHOOK_SECRET=

# ── LLM Provider (optional) ──────────────────────────────────────────────────
# Set to "openai" or "google" and provide the key for LLM-based buyers.
# Leave as "dummy" to run without an LLM (uses mock adapter — still fully functional).
LLM_PROVIDER=dummy
# LLM_API_KEY=sk-...

# ── Chaos Engine ─────────────────────────────────────────────────────────────
CHAOS_SEED=42

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
